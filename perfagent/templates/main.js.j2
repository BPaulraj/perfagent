import { SharedArray } from 'k6/data';
import { buildOptions, setupAuth, registerData, registerHooks, parseCsv, textReport } from './lib/common.js';
import * as PROJECT_HOOKS from './hooks.js';
{% for s in workload.scenarios %}
import { {{ s.fn }} } from './scenarios/{{ s.fn }}.js';
{% endfor %}

const WORKLOAD = JSON.parse(open('./workload.json'));

// Test data (CSV) is loaded once and shared read-only across VUs
const DATA = {};
{% for s in workload.scenarios if s.data_file %}
DATA[{{ s.id | tojs }}] = new SharedArray({{ s.id | tojs }}, () => parseCsv(open({{ ('./data/' ~ s.data_file) | tojs }})));
{% endfor %}
registerData(DATA, WORKLOAD);
registerHooks(PROJECT_HOOKS);

export const options = buildOptions(WORKLOAD, __ENV.TEST_TYPE || 'smoke');

export function setup() {
  return setupAuth(WORKLOAD.auth);
}

export { {% for s in workload.scenarios %}{{ s.fn }}{{ ", " if not loop.last }}{% endfor %} };

export function handleSummary(data) {
  const out = {};
  out[__ENV.SUMMARY_PATH || 'summary.json'] = JSON.stringify(data, null, 2);
  out.stdout = textReport(data, WORKLOAD);
  return out;
}
